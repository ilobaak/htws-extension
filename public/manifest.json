{
  "manifest_version": 3,
  "name": "Hibernate Tabs, Windows, and Sessions",
  "short_name": "HTWS",
  "version": "1.0.1",
  "description": "Hibernate tabs, windows, or full sessions to free memory, then restore them with order, groups, and pins intact.",
  "incognito": "spanning",
  "minimum_chrome_version": "119",
  "permissions": [
    "alarms",
    "bookmarks",
    "contextMenus",
    "scripting",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Hibernate Tabs, Windows, and Sessions"
  },
  "options_page": "options.html"
}
